# Supabase: Dashboard → Project Settings → API
# - Project URL  → VITE_SUPABASE_URL
# - anon public  → VITE_SUPABASE_ANON_KEY
#
# Copy this file to `.env.local` (same folder as package.json), paste values, restart `npm run dev`.
# Vite only exposes variables whose names start with VITE_ — do not use SUPABASE_URL without the prefix.
#
# Vercel: same variable names under Project → Settings → Environment Variables, then Redeploy.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
